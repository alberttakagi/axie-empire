# Copy to .env.local (git-ignored) for local dev, and add the same two
# variables in Vercel → Project → Settings → Environment Variables.
# Supabase → Project Settings → API. The anon key is public by design;
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Sky Mavis Account (Ronin Waypoint) — Ronin Developer Console → Products →
# Waypoint Account Service → CLIENT ID. Also set it as an Edge Function
# secret: supabase secrets set WAYPOINT_CLIENT_ID=...
VITE_WAYPOINT_CLIENT_ID=your-waypoint-client-id
