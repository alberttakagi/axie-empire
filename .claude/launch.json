{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "axie-skirmish-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "sprite-gen-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "tools/sprite-gen",
        "run",
        "dev"
      ],
      "port": 5180,
      "autoPort": true
    },
    {
      "name": "spritegen",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd tools/sprite-gen && npx vite --port 5181 --strictPort"
      ],
      "port": 5181
    }
  ]
}